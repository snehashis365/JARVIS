# Jarvis Configuration Example
# Copy this file to .env to customize settings

# Application Environment
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Assistant Identity
JARVIS_NAME=Jarvis
JARVIS_TONE=helpful
JARVIS_FORMALITY=balanced
JARVIS_VERBOSITY=concise

# Operating Modes
# inference_mode: local | cloud | hybrid
JARVIS_INFERENCE_MODE=local

# autonomy_mode: plan | agent_decides | auto | sandbox_only
JARVIS_AUTONOMY_MODE=agent_decides

# Local LLM Provider Settings (Ollama / LM Studio / llama.cpp)
JARVIS_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1
JARVIS_LOCAL_MODEL=llama3.2

# Hosted Provider Settings (Optional - leave empty for local-only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Cloud Sync
JARVIS_SYNC_ENABLED=false
JARVIS_SYNC_SERVER_URL=
